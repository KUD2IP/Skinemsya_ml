# Шаблон для production ML. Скопируй, заполни, затем добавь содержимое в
# GitHub → Settings → Environments → production → secret PRODUCTION_ENV
# (multiline).
#
# APP_VERSION и GHCR_OWNER дописываются автоматически в CI при деплое.
# GHCR_OWNER — владелец пакета GitHub (user или org), lowercase.

GHCR_OWNER=your-github-owner

# Потоки onnxruntime на слабом VPS.
ML_OCR_THREADS=1

# После деплоя укажи в PRODUCTION_ENV бека:
#   ML_SERVICE_URL=http://172.17.0.1:8001
# (или host.docker.internal:8001, если настроен extra_hosts у бека)
